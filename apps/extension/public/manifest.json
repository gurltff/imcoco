{
  "manifest_version": 3,
  "name": "Coco's Corner",
  "version": "0.1.0",
  "description": "Coco, a chubby black cat with green eyes, walks along the bottom of your pages, naps, meows and purrs.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Coco's Corner", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["audio/*"], "matches": ["<all_urls>"] }]
}
